PORT=5000
# Leave MONGODB_URI empty in local dev to use an in-memory MongoDB (data resets on restart).
# For production use a MongoDB Atlas connection string.
MONGODB_URI=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Origin only (no path, no trailing slash); comma-separate to allow several.
# Production (GitHub Pages): CLIENT_ORIGIN=https://aamani2702.github.io
CLIENT_ORIGIN=http://localhost:5173
